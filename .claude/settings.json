{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.gnupg",
        "~/.kube",
        "~/.config/gh",
        "~/.docker/config.json",
        "~/**/.env",
        "~/**/.env.*",
        "~/**/.pem",
        "~/**/.key"
      ],
      "denyWrite": ["~/.ssh", "~/.gnupg", "~/.kube", "~/.config/gh", "~/.docker"]
    }
  },
  "permissions": {
    "allow": [
      "Bash(awk:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(gh auth status:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr view:*)",
      "Bash(gh release list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh workflow list:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(pre-commit --version)",
      "Bash(pre-commit install:*)",
      "Bash(pre-commit run:*)",
      "Bash(pwd)",
      "Bash(rg:*)",
      "Bash(shellcheck:*)",
      "Bash(tail:*)",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(gh repo delete:*)",
      "Bash(gh secret set:*)",
      "Bash(gh secret delete:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*secret*)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.config/gh/**)"
    ],
    "defaultMode": "auto"
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    }
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "clangd-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "env": {
    "GITHUB_PERSONAL_ACCESS_TOKEN": "{{ claude_github_pat }}"
  },
  "effortLevel": "high",
  "theme": "auto",
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true
}
